---
// 自建 404 页面（不是服务器默认页），带返回首页和主要分类的链接。
// 规则见 AGENTS.md「抓取基础设施规则」。
import BaseLayout from '../layouts/BaseLayout.astro';
import { navLinks } from '../config/site.config';

const title = 'Page Not Found | MyBrand';
const description = 'The page you are looking for does not exist. Browse our products, solutions and blog, or return to the homepage.';
const pathname = '/404/';
---

<BaseLayout title={title} description={description} pathname={pathname} noindex={true}>
  <article>
    <h1>Page not found (404)</h1>
    <p>Sorry, this page does not exist or has moved. Here are some useful places to go:</p>
    <ul>
      <li><a href="/">Home</a></li>
      {navLinks.filter((l) => l.href !== '/').map((l) => (
        <li><a href={l.href}>{l.label}</a></li>
      ))}
    </ul>
  </article>
</BaseLayout>
